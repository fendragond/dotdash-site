---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { LOCALES, t, type Locale } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';

export async function getStaticPaths() {
	return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout
	locale={locale}
	title={t(locale, 'nav.home')}
	description={t(locale, 'home.intro')}
>
	<PageHero
		title={t(locale, 'nav.home')}
		eyebrow={t(locale, 'home.eyebrow')}
		watermark={t(locale, 'home.watermark')}
		intro={t(locale, 'home.intro')}
	/>
	<CtaBand
		title={t(locale, 'cta.title')}
		subtitle={t(locale, 'cta.subtitle')}
		primaryLabel={t(locale, 'cta.primary')}
		primaryHref={localizedPath(locale, 'contact')}
		secondaryLabel={t(locale, 'cta.secondary')}
		secondaryHref="#"
		secondaryExternal={false}
	/>
</BaseLayout>

---
import '../styles/global.css';
import type { Locale } from '../i18n/ui';
import { DEFAULT_LOCALE, LOCALES, LOCALE_DIR } from '../i18n/ui';
import { switchLocalePath } from '../i18n/routing';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	canonical?: string;
	/** Page-level robots directive. Omitted (or index,follow) → no robots meta tag. */
	robots?: string;
	ogImage?: string;
	/** GA4 measurement id; if absent, no analytics emitted. */
	ga4Id?: string;
	preloadHero?: string;
	/** Reserved for a future SchemaOrg slot. */
	schema?: boolean;
}

const {
	locale,
	title,
	description,
	canonical,
	robots: robotsProp,
	ogImage: ogImageProp,
	ga4Id,
	preloadHero,
	schema = false,
} = Astro.props;

void schema; // reserved — SchemaOrg slot lands in a later milestone

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(ogImageProp ?? '{{TODO:og-image-default}}', Astro.site).href;
const dir = LOCALE_DIR[locale];

/** Crawlers default to index,follow — omit the meta tag in that case. */
const DEFAULT_ROBOTS = 'index, follow';
const normalizedRobots = robotsProp?.trim().replace(/\s*,\s*/g, ', ').toLowerCase();
const robots =
	!normalizedRobots || normalizedRobots === DEFAULT_ROBOTS ? undefined : robotsProp!.trim();

const alternateUrls = LOCALES.map((loc) => ({
	loc,
	href: new URL(switchLocalePath(Astro.url.pathname, loc), Astro.site).href,
}));
const xDefaultHref = new URL(
	switchLocalePath(Astro.url.pathname, DEFAULT_LOCALE),
	Astro.site,
).href;
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="{{TODO:site-name}}" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		{
			preloadHero && (
				<link rel="preload" as="image" href={preloadHero} fetchpriority="high" />
			)
		}
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{robots && <meta name="robots" content={robots} />}
		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:description" content={description} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		{
			alternateUrls.map(({ loc, href }) => (
				<link rel="alternate" hreflang={loc} href={href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<slot name="head" />
		{
			ga4Id && (
				<>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
					<script
						is:inline
						set:html={`window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${ga4Id}');`}
					/>
				</>
			)
		}
	</head>
	<body>
		<Navbar />
		<main class="min-h-screen" style="padding-block-start: var(--nav-h);">
			<slot />
		</main>
		<Footer />
		<script>
			import { initReveal } from '../scripts/reveal';

			function bootReveal() {
				initReveal();
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', bootReveal, { once: true });
			} else {
				bootReveal();
			}
		</script>
	</body>
</html>
